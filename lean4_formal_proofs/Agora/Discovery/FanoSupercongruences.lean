/-!
## CKK(1) Period Formula and Agreement

For P⁴ (projective 4-space), the quantum period coefficients are:
  a(n) = (5d)! / (d!)⁵  where d = n/5 if 5∣n
  a(n) = 0               otherwise

This is distinct from the S20 hypergeometric sum formula
  S20(n) = Σ_{k=0}^{n} C(n,k)⁴ · C(n+k,k)
which gives the **classical period** (Picard-Fuchs solution) values.

The supercongruence conjecture is about the quantum period
coefficients a(p), NOT the classical period values S20(p).
-/

/-- CKK(1) quantum period formula: a(n) = (5d)!/(d!)⁵ if n = 5d, else 0. -/
def periodFormula_1 (i : Fin 32) : ℤ :=
  if i.val % 5 = 0 then
    let d := i.val / 5
    ↑(Nat.factorial (5 * d) / (Nat.factorial d) ^ 5)
  else 0

/-- The quantum period formula agrees with the CCGK lookup table at all 32 positions.
    Kernel-verified by `decide`. -/
theorem periodFormula_1_eq_fanoSeq_1 :
    ∀ i : Fin 32, periodFormula_1 i = fanoSeq_1 i := by decide

/-- S20(1) = 3 ≠ 0 = a(1): the classical and quantum periods are different sequences. -/
theorem s20_ne_period_at_1 : S20_formula 1 ≠ fanoSeq_1 ⟨1, by omega⟩ := by decide

/-- Period coefficient at n=5 is 120 = 5!/1 — the first non-trivial quantum term. -/
theorem period_1_val_5 : fanoSeq_1 ⟨5, by omega⟩ = 120 := by decide

/-- S20(5) = 852753 — confirming the classical period value. -/
theorem s20_val_5 : S20_formula 5 = 852753 := by decide

