{
  "llm": {
    "provider": "google",
    "model": "gemini-3.5-flash"
  },
  "agents": {
    "CosmologyAgent": {
      "strict_cag_mode": true
    },
    "TopologyAgent": {
      "strict_cag_mode": true,
      "enable_multiway_graphs": true
    }
  },
  "mcp": {
    "wolfram-engine": {
      "status": "initialized",
      "endpoint": "local/gcp-wolfram"
    }
  }
}